# Public server
NODE_ENV=development
PORT=3000
AUTH_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
# Set to 1 when the app runs behind Nginx, Caddy, Cloudflare, Render, Railway, Fly, etc.
TRUST_PROXY=0
JSON_BODY_LIMIT=5mb

# Production example:
# NODE_ENV=production
# AUTH_BASE_URL=https://dnd.example.com
# TRUST_PROXY=1

# Google OAuth
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Authorized redirect URI:
#   http://localhost:3000/auth/google/callback
# Production redirect URI:
#   https://dnd.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional access allowlist. Leave empty to allow any Google account.
# Example: admin@example.com,dm@example.com
ALLOWED_EMAILS=

# Optional future AI assistant endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Local server data. This folder is ignored by git.
DATA_DIR=.data
