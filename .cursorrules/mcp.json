{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem"],
      "env": {
        "MCP_FS_ROOT": "${workspaceFolder}"
      }
    },
    "shell": {
      "command": "npx",
      "args": ["-y", "@mkusaka/mcp-shell-server"],
      "env": {
        "MCP_SHELL_ALLOW": "php,composer,git,python,jq"
      }
    },
    "jq": {
      "command": "npx",
      "args": ["-y", "mcp-jq"]
    }
  }
}
