{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "D&D Names Schema",
    "description": "Schema for D&D character names data",
    "type": "object",
    "properties": {
        "race": {
            "type": "string",
            "description": "Race name in Russian"
        },
        "race_en": {
            "type": "string",
            "description": "Race name in English"
        },
        "male_names": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Male names for the race"
        },
        "female_names": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Female names for the race"
        },
        "surnames": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Surnames for the race"
        },
        "nicknames": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Nicknames for the race"
        },
        "name_patterns": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "pattern": { "type": "string" },
                    "description": { "type": "string" },
                    "example": { "type": "string" }
                },
                "required": ["pattern", "description"]
            },
            "description": "Naming patterns for the race"
        },
        "cultural_notes": {
            "type": "string",
            "description": "Cultural notes about naming conventions"
        }
    },
    "required": ["race", "male_names", "female_names"]
}