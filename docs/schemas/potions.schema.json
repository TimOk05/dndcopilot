{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "D&D Potions Schema",
    "description": "Schema for D&D potions data",
    "type": "object",
    "properties": {
        "potions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the potion"
                    },
                    "name": {
                        "type": "string",
                        "description": "Potion name in Russian"
                    },
                    "name_en": {
                        "type": "string",
                        "description": "Potion name in English"
                    },
                    "rarity": {
                        "type": "string",
                        "enum": ["Обычный", "Необычный", "Редкий", "Очень редкий", "Легендарный", "Артефакт"],
                        "description": "Potion rarity"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["Зелье", "Эликсир", "Настойка", "Отвар", "Бальзам"],
                        "description": "Potion type"
                    },
                    "description": {
                        "type": "string",
                        "description": "Potion description in Russian"
                    },
                    "effects": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "description": { "type": "string" },
                                "duration": { "type": "string" },
                                "type": {
                                    "type": "string",
                                    "enum": ["Временный", "Постоянный", "Накопительный"]
                                }
                            },
                            "required": ["name", "description"]
                        }
                    },
                    "ingredients": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "quantity": { "type": "string" },
                                "rarity": { "type": "string" }
                            },
                            "required": ["name", "quantity"]
                        }
                    },
                    "crafting": {
                        "type": "object",
                        "properties": {
                            "time": { "type": "string" },
                            "difficulty": { "type": "string" },
                            "tools": { "type": "array", "items": { "type": "string" } },
                            "skills": { "type": "array", "items": { "type": "string" } }
                        }
                    },
                    "value": {
                        "type": "object",
                        "properties": {
                            "gold": { "type": "integer", "minimum": 0 },
                            "silver": { "type": "integer", "minimum": 0 },
                            "copper": { "type": "integer", "minimum": 0 }
                        }
                    },
                    "weight": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Weight in pounds"
                    },
                    "tags": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Tags for categorization"
                    }
                },
                "required": ["id", "name", "rarity", "type", "description"]
            }
        }
    },
    "required": ["potions"]
}