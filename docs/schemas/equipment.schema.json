{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "D&D Equipment Schema",
    "description": "Schema for D&D equipment data",
    "type": "object",
    "properties": {
        "equipment": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the equipment"
                    },
                    "name": {
                        "type": "string",
                        "description": "Equipment name in Russian"
                    },
                    "name_en": {
                        "type": "string",
                        "description": "Equipment name in English"
                    },
                    "category": {
                        "type": "string",
                        "enum": ["Броня", "Оружие", "Щит", "Инструмент", "Снаряжение", "Магический предмет"],
                        "description": "Equipment category"
                    },
                    "subcategory": {
                        "type": "string",
                        "description": "Equipment subcategory"
                    },
                    "description": {
                        "type": "string",
                        "description": "Equipment description in Russian"
                    },
                    "rarity": {
                        "type": "string",
                        "enum": ["Обычный", "Необычный", "Редкий", "Очень редкий", "Легендарный", "Артефакт"],
                        "description": "Equipment rarity"
                    },
                    "value": {
                        "type": "object",
                        "properties": {
                            "gold": { "type": "integer", "minimum": 0 },
                            "silver": { "type": "integer", "minimum": 0 },
                            "copper": { "type": "integer", "minimum": 0 }
                        }
                    },
                    "weight": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Weight in pounds"
                    },
                    "properties": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "value": { "type": "string" },
                                "description": { "type": "string" }
                            },
                            "required": ["name", "value"]
                        }
                    },
                    "requirements": {
                        "type": "object",
                        "properties": {
                            "strength": { "type": "integer", "minimum": 0 },
                            "proficiency": { "type": "string" },
                            "class": { "type": "array", "items": { "type": "string" } }
                        }
                    },
                    "effects": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "description": { "type": "string" },
                                "type": {
                                    "type": "string",
                                    "enum": ["Бонус", "Штраф", "Особое свойство", "Заклинание"]
                                }
                            },
                            "required": ["name", "description", "type"]
                        }
                    },
                    "tags": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Tags for categorization"
                    }
                },
                "required": ["id", "name", "category", "description", "rarity"]
            }
        }
    },
    "required": ["equipment"]
}