{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "D&D Classes Schema",
    "description": "Schema for D&D character classes data",
    "type": "object",
    "properties": {
        "classes": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the class"
                    },
                    "name": {
                        "type": "string",
                        "description": "Class name in Russian"
                    },
                    "name_en": {
                        "type": "string",
                        "description": "Class name in English"
                    },
                    "description": {
                        "type": "string",
                        "description": "Class description in Russian"
                    },
                    "hit_die": {
                        "type": "integer",
                        "enum": [6, 8, 10, 12],
                        "description": "Hit die size for the class"
                    },
                    "primary_ability": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": ["Сила", "Ловкость", "Телосложение", "Интеллект", "Мудрость", "Харизма"]
                        },
                        "description": "Primary ability scores for the class"
                    },
                    "saving_throw_proficiencies": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": ["Сила", "Ловкость", "Телосложение", "Интеллект", "Мудрость", "Харизма"]
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "Saving throw proficiencies"
                    },
                    "skill_proficiencies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Available skill proficiencies"
                    },
                    "starting_equipment": {
                        "type": "object",
                        "properties": {
                            "armor": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "weapons": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "tools": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "packs": {
                                "type": "array",
                                "items": { "type": "string" }
                            },
                            "gold": {
                                "type": "integer",
                                "minimum": 0
                            }
                        }
                    },
                    "features": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "level": { "type": "integer", "minimum": 1, "maximum": 20 },
                                "name": { "type": "string" },
                                "description": { "type": "string" },
                                "type": {
                                    "type": "string",
                                    "enum": ["class_feature", "spellcasting", "ability_score_improvement", "subclass_feature"]
                                }
                            },
                            "required": ["level", "name", "description", "type"]
                        }
                    },
                    "spellcasting": {
                        "type": "object",
                        "properties": {
                            "ability": {
                                "type": "string",
                                "enum": ["Интеллект", "Мудрость", "Харизма"]
                            },
                            "spell_slots": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "level": { "type": "integer", "minimum": 1, "maximum": 9 },
                                        "slots": { "type": "integer", "minimum": 0 }
                                    },
                                    "required": ["level", "slots"]
                                }
                            }
                        }
                    },
                    "subclasses": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "description": { "type": "string" },
                                "features": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "level": { "type": "integer", "minimum": 1, "maximum": 20 },
                                            "name": { "type": "string" },
                                            "description": { "type": "string" }
                                        },
                                        "required": ["level", "name", "description"]
                                    }
                                }
                            },
                            "required": ["name", "description"]
                        }
                    }
                },
                "required": ["id", "name", "description", "hit_die", "primary_ability", "saving_throw_proficiencies"]
            }
        }
    },
    "required": ["classes"]
}