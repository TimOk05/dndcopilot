{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "D&D Races Schema",
    "description": "Schema for D&D character races data",
    "type": "object",
    "properties": {
        "races": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the race"
                    },
                    "name": {
                        "type": "string",
                        "description": "Race name in Russian"
                    },
                    "name_en": {
                        "type": "string",
                        "description": "Race name in English"
                    },
                    "description": {
                        "type": "string",
                        "description": "Race description in Russian"
                    },
                    "ability_score_increases": {
                        "type": "object",
                        "properties": {
                            "strength": { "type": "integer", "minimum": 0, "maximum": 2 },
                            "dexterity": { "type": "integer", "minimum": 0, "maximum": 2 },
                            "constitution": { "type": "integer", "minimum": 0, "maximum": 2 },
                            "intelligence": { "type": "integer", "minimum": 0, "maximum": 2 },
                            "wisdom": { "type": "integer", "minimum": 0, "maximum": 2 },
                            "charisma": { "type": "integer", "minimum": 0, "maximum": 2 }
                        },
                        "additionalProperties": false
                    },
                    "size": {
                        "type": "string",
                        "enum": ["Маленький", "Средний", "Большой"],
                        "description": "Race size category"
                    },
                    "speed": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Base movement speed in feet"
                    },
                    "languages": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Languages known by the race"
                    },
                    "traits": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "description": { "type": "string" }
                            },
                            "required": ["name", "description"]
                        }
                    },
                    "subraces": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "description": { "type": "string" },
                                "ability_score_increases": {
                                    "type": "object",
                                    "properties": {
                                        "strength": { "type": "integer", "minimum": 0, "maximum": 2 },
                                        "dexterity": { "type": "integer", "minimum": 0, "maximum": 2 },
                                        "constitution": { "type": "integer", "minimum": 0, "maximum": 2 },
                                        "intelligence": { "type": "integer", "minimum": 0, "maximum": 2 },
                                        "wisdom": { "type": "integer", "minimum": 0, "maximum": 2 },
                                        "charisma": { "type": "integer", "minimum": 0, "maximum": 2 }
                                    },
                                    "additionalProperties": false
                                },
                                "traits": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "name": { "type": "string" },
                                            "description": { "type": "string" }
                                        },
                                        "required": ["name", "description"]
                                    }
                                }
                            },
                            "required": ["name", "description"]
                        }
                    }
                },
                "required": ["id", "name", "description", "ability_score_increases", "size", "speed"]
            }
        }
    },
    "required": ["races"]
}