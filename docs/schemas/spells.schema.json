{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "D&D Spells Schema",
    "description": "Schema for D&D spells data",
    "type": "object",
    "properties": {
        "spells": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the spell"
                    },
                    "name": {
                        "type": "string",
                        "description": "Spell name in Russian"
                    },
                    "name_en": {
                        "type": "string",
                        "description": "Spell name in English"
                    },
                    "level": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9,
                        "description": "Spell level (0 for cantrips)"
                    },
                    "school": {
                        "type": "string",
                        "enum": ["Воплощение", "Вызов", "Иллюзия", "Некромантия", "Ограждение", "Очарование", "Преобразование", "Прорицание"],
                        "description": "School of magic"
                    },
                    "casting_time": {
                        "type": "string",
                        "description": "Casting time (e.g., '1 действие', '1 минута')"
                    },
                    "range": {
                        "type": "string",
                        "description": "Spell range (e.g., 'На себя', '30 футов')"
                    },
                    "components": {
                        "type": "object",
                        "properties": {
                            "verbal": { "type": "boolean" },
                            "somatic": { "type": "boolean" },
                            "material": { "type": "boolean" },
                            "material_description": { "type": "string" }
                        },
                        "required": ["verbal", "somatic", "material"]
                    },
                    "duration": {
                        "type": "string",
                        "description": "Spell duration (e.g., 'Мгновенно', '1 час')"
                    },
                    "description": {
                        "type": "string",
                        "description": "Spell description in Russian"
                    },
                    "higher_levels": {
                        "type": "string",
                        "description": "Description of effects at higher levels"
                    },
                    "classes": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": ["Бард", "Варвар", "Воин", "Волшебник", "Друид", "Жрец", "Изобретатель", "Колдун", "Монах", "Паладин", "Плут", "Следопыт", "Чародей"]
                        },
                        "description": "Classes that can cast this spell"
                    },
                    "ritual": {
                        "type": "boolean",
                        "description": "Whether the spell can be cast as a ritual"
                    },
                    "concentration": {
                        "type": "boolean",
                        "description": "Whether the spell requires concentration"
                    }
                },
                "required": ["id", "name", "level", "school", "casting_time", "range", "components", "duration", "description", "classes"]
            }
        }
    },
    "required": ["spells"]
}